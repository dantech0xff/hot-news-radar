# === AI provider selection ===
# Supported: claude, openai, groq, gemini, qwen, deepseek, ollama, openrouter, together, custom, none
AI_PROVIDER=claude
AI_MODEL=

# === AI API keys ===
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
QWEN_API_KEY=your-qwen-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
TOGETHER_API_KEY=your-together-api-key

# === Cloudflare AI Gateway BYOK for Gemini ===
# When all three values are set, Gemini uses the provider key stored in AI Gateway
# instead of sending GEMINI_API_KEY from this runtime.
CF_AIG_TOKEN=your-cloudflare-ai-gateway-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
AI_GATEWAY_ID=your-ai-gateway-id
AI_GATEWAY_BYOK_ALIAS=

# === Local or custom AI ===
OLLAMA_BASE_URL=http://localhost:11434/v1
CUSTOM_AI_API_KEY=your-custom-ai-key
CUSTOM_AI_BASE_URL=https://example.com/v1
CUSTOM_AI_MODEL=your-custom-model
CUSTOM_AI_NAME=Custom AI

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# === Optional output credentials ===
FB_PAGE_TOKEN=your-facebook-page-token
FB_PAGE_ID=your-facebook-page-id

# === Cache and delivery store (Node CLI) ===
# The dashboard app also loads this file. Give it its own cache inside DATA_DIR
# (e.g. CACHE_PATH=.cache/app-data/news.json set on the command line, which wins
# over .env) instead of sharing the CLI cache file below; the app accepts only
# CACHE_TYPE=file or unset.
CACHE_TYPE=file
CACHE_PATH=./.cache/news.json
REDIS_URL=redis://localhost:6379
DELIVERY_STORE_TYPE=file
DELIVERY_STORE_PATH=./.cache/delivery-state.json

# === Schedule and tuning ===
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=UTC
BROADCAST_MODE=drip
MAX_ARTICLES=18
MAX_ARTICLES_PER_SOURCE=3
CONCURRENCY_LIMIT=5
DRIP_BATCH_SIZE=5
DRIP_DELAY_MS=0
# Maximum articles queued per publishing day for the Telegram radar (1-500)
DRIP_DAILY_LIMIT=18

# === Operator recovery (Node CLI) ===
# Audit identity recorded by the recovery commands.
OPERATOR_KEY_ID=operator-main

# === Dashboard app (npm run app; rules in src/app/config/env.js) ===
# Needs Node.js >= 22.13 (node:sqlite). Startup fails fast and names the bad
# variable without echoing its value. The Docker image sets NODE_ENV=production,
# HOST=0.0.0.0, PORT=3000, DATA_DIR=/data, and CACHE_PATH=/data/news.json.
# HOST=127.0.0.1
# PORT=3000
# Directory for content-radar.db, its backups/, and the app cache (default DATA_DIR/news.json).
DATA_DIR=./.cache/app-data
# Base64 of 32 random bytes (openssl rand -base64 32); encrypts stored channel
# secrets. Keep it stable and keep a copy in a password manager: losing it means
# re-entering every secret.
APP_MASTER_KEY=your-base64-32-byte-master-key
# Cloudflare Access: team domain (https origin) and the application AUD tag(s), comma-separated.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-aud-tag
# Roles, comma-separated; an operator can also do everything a viewer can.
APP_OPERATOR_EMAILS=ops@example.com
APP_VIEWER_EMAILS=
# Access service tokens as <client-id>:operator or <client-id>:viewer, comma-separated.
APP_SERVICE_TOKEN_ROLES=
# Exact origin users open; every change request must carry it as Origin.
PUBLIC_ORIGIN=https://radar.example.com
# Days to keep scanned-but-unposted library items, and run/source-health history.
# Posted items are kept forever.
CONTENT_SCAN_RETENTION_DAYS=30
RUN_HISTORY_RETENTION_DAYS=180
# Seconds SIGTERM waits for a run in flight; give the container a stop grace
# period of at least this value + 15 s (135 s by default).
SHUTDOWN_WAIT_SECONDS=120
# Development only: local Access signing keys from `npm run dev:token`. Accepted
# only with NODE_ENV=development or test; any other NODE_ENV refuses to start.
# ACCESS_JWKS_FILE=.cache/dev-access/jwks.json

# === Deploy script (npm run deploy:*; see docs/deployment.md) ===
# IPv4 address of the VPS that the hostname's proxied A record points to; set it in your local .env only.
ORIGIN_IP=
